rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user can read/write ONLY their own document.
    // Payment status changes go through the verifyPayment / webhook
    // Cloud Functions (Admin SDK), which bypass these rules — so a
    // user cannot forge their own "isPremium: true".
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && !("isPremium" in request.resource.data.diff(resource.data).affectedKeys())
                   && !("premiumExpiry" in request.resource.data.diff(resource.data).affectedKeys());
    }

    // Only Cloud Functions (Admin SDK) write here; no client access needed.
    match /content_updates/{updateId} {
      allow read, write: if false;
    }
  }
}
